{
  "name": "react-native-mapp-plugin",
  "version": "2.0.0",
  "description": "Mapp SDK for React Native.",
  "main": "index.js",
  "files": [
    "android/build.gradle",
    "android/gradle.properties",
    "android/gradle/",
    "android/gradlew",
    "android/gradlew.bat",
    "android/settings.gradle",
    "android/src/main/",
    "ios/Frameworks/",
    "ios/RNMappEventEmmiter.h",
    "ios/RNMappEventEmmiter.m",
    "ios/RNMappPlugin.xcodeproj/project.pbxproj",
    "ios/RNMappPluginModule.h",
    "ios/RNMappPluginModule.mm",
    "app.plugin.js",
    "plugin/build/",
    "android/src/main/jni/",
    "specs/",
    "BREAKING_CHANGES.md",
    "CHANGELOG.md",
    "MIGRATION_2.0.md",
    "CustomEvent.js",
    "Mapp.js",
    "MappEventEmitter.js",
    "README.md",
    "RNMappPlugin.podspec",
    "index.js",
    "react-native.config.js"
  ],
  "keywords": [
    "react-native",
    "react",
    "react-component",
    "ios",
    "android",
    "mapp"
  ],
  "author": "Mapp",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.4"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=56.0.0",
    "react": "^19.2.3",
    "react-native": ">=0.84"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "dependencies": {
    "@expo/plist": "^0.7.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-flow": "^7.27.1",
    "@expo/config-plugins": "~56.0.14",
    "@react-native-community/cli": "^20.1.3",
    "@react-native/codegen": "0.85.3",
    "@react-native/gradle-plugin": "0.85.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "babel-jest": "^30.3.0",
    "jest": "^30.2.0",
    "react": "19.2.4",
    "react-native": "0.85.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "test:plugin": "jest --runInBand plugin/__tests__",
    "generate:codegen": "react-native codegen specs",
    "build:android": "cd android && ./gradlew assembleDebug",
    "test": "jest",
    "prepare": "npm run build:plugin"
  },
  "codegenConfig": {
    "name": "RNMappPlugin",
    "type": "modules",
    "jsSrcsDir": "./specs",
    "includesGeneratedCode": true,
    "android": {
      "javaPackageName": "com.reactlibrary"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/plugin/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest",
      "^.+\\.ts$": ["ts-jest", { "tsconfig": "plugin/tsconfig.json" }]
    },
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/__mocks__/react-native.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mapp-digital/Mapp-Engage-ReactNative-Plugin.git"
  },
  "bugs": {
    "url": "https://github.com/mapp-digital/Mapp-Engage-ReactNative-Plugin/issues"
  },
  "homepage": "https://github.com/mapp-digital/Mapp-Engage-ReactNative-Plugin#readme"
}
